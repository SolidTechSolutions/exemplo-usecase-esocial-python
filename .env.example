SOLIDSIGN_API_BASE_URL=https://solidsign.com.br
SOLIDSIGN_API_AUTHORIZATION=Bearer YOUR_JWT_TOKEN_HERE

# [EN]    Fixed signature parameters for any eSocial event (S-1000, S-2200, etc.) — the whole
#         <eSocial> envelope is always signed (no signatureNodeName).
# [PT-BR] Parâmetros fixos pra qualquer evento eSocial — o envelope inteiro é sempre assinado.
SOLIDSIGN_ESOCIAL_PROFILE=XML_INTERNATIONAL
SOLIDSIGN_ESOCIAL_HASH_ALGORITHM=SHA256
SOLIDSIGN_ESOCIAL_SIGNATURE_PACKAGING=ENVELOPED
SOLIDSIGN_ESOCIAL_CANONICALIZATION_METHOD=INCLUSIVE
SOLIDSIGN_ESOCIAL_REMOVE_XPATH_FILTER=true
SOLIDSIGN_ESOCIAL_REMOVE_NAMESPACE_PREFIX=true
